---
import Icon from './Icon.astro';
import { projectCode, projectTitle, projectHref, blurbOf, videosOf } from '../lib/projects.js';
import { assetUrl } from '../lib/url.js';

const { project } = Astro.props;

const cover = project.images.find((i) => i.exists) ?? null;
const blurb = blurbOf(project);
const hasVideo = videosOf(project).length > 0;
---
<a href={projectHref(project)}
  class={`group flex flex-col h-full rounded-2xl border overflow-hidden transition-all duration-300 ${
    project.populated
      ? 'bg-slate-800/40 border-white/10 hover:border-purple-400/40 hover:bg-slate-800/70 hover:-translate-y-1'
      : 'bg-slate-900/40 border-white/5 hover:border-white/15'
  }`}>

  <!-- Cover — fixed aspect so a mixed grid stays aligned -->
  <div class="relative aspect-[16/10] bg-slate-900 overflow-hidden flex-shrink-0">
    {cover ? (
      <img src={assetUrl(cover.src)} alt={`${projectTitle(project)} — preview`} loading="lazy" decoding="async"
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
    ) : (
      <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-purple-900/20 via-slate-900 to-blue-900/20">
        <Icon name={project.populated ? 'image-off' : 'clock'} size={36} class="text-white/15" />
      </div>
    )}

    <span class="absolute top-3 left-3 font-mono text-xs font-bold px-2 py-1 rounded-md bg-slate-950/80 backdrop-blur border border-white/10 text-purple-300">
      {projectCode(project)}
    </span>

    {project.status && (
      <span class="absolute top-3 right-3 text-[11px] font-semibold px-2.5 py-1 rounded-full bg-purple-500/20 backdrop-blur border border-purple-400/40 text-purple-200">
        {project.status}
      </span>
    )}
    {!project.populated && (
      <span class="absolute top-3 right-3 text-[11px] font-semibold px-2.5 py-1 rounded-full bg-slate-800/80 backdrop-blur border border-white/10 text-gray-400">
        Coming Soon
      </span>
    )}

    <!-- Bottom-left, clear of the code and status badges above it -->
    {hasVideo && (
      <span class="absolute bottom-3 left-3 inline-flex items-center gap-1.5 text-[11px] font-semibold px-2 py-1 rounded-md bg-slate-950/80 backdrop-blur border border-white/10 text-gray-200">
        <Icon name="play" size={11} class="fill-current" />
        Video
      </span>
    )}
  </div>

  <!--
    Every text row below reserves a fixed number of lines, so a 3-line title no
    longer makes its card taller than its neighbours. Heights are in `em`, which
    resolves against each element's own font size — change the font size or the
    leading and the reserved space follows automatically.
      title  3 lines x leading-snug (1.375)    = 4.125em
      type   1 line  x text-xs leading (1rem)
      blurb  3 lines x leading-relaxed (1.625) = 4.875em
  -->
  <div class="flex flex-col flex-grow p-5">
    <h3 class={`text-lg font-bold leading-snug mb-1 line-clamp-3 min-h-[4.125em] transition-colors ${project.populated ? 'text-white group-hover:text-purple-300' : 'text-gray-400'}`}>
      {projectTitle(project)}
    </h3>

    <!-- Rendered even when empty so the blurb starts at the same y on every card. -->
    <p class="text-xs text-blue-300/80 mb-3 min-h-[1rem] truncate">{project.projectType}</p>

    {blurb ? (
      <p class="text-sm text-gray-400 leading-relaxed line-clamp-3 min-h-[4.875em] mb-4">{blurb}</p>
    ) : (
      <p class="text-sm text-gray-600 italic leading-relaxed min-h-[4.875em] mb-4">Write-up in progress.</p>
    )}

    <div class="mt-auto pt-3 border-t border-white/5 flex items-center justify-between gap-3">
      <!-- nowrap keeps the tag strip to a single line however long the names are -->
      <div class="flex flex-nowrap gap-1.5 min-w-0 overflow-hidden">
        {project.disciplines.slice(0, 2).map((d) => (
          <span class="text-[11px] px-2 py-0.5 rounded-md bg-white/5 border border-white/10 text-gray-400 truncate">{d}</span>
        ))}
        {project.disciplines.length > 2 && (
          <span class="text-[11px] px-2 py-0.5 text-gray-600 flex-shrink-0">+{project.disciplines.length - 2}</span>
        )}
      </div>
      <Icon name="arrow-right" size={18}
        class="text-purple-400 flex-shrink-0 opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300" />
    </div>
  </div>
</a>
