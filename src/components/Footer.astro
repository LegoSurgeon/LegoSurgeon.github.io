---
import { projects, projectCode, projectHref, AUTHOR, SITE_TITLE, projectCount, populatedCount } from '../lib/projects.js';
import { url } from '../lib/url.js';

// Footer lists documented work only — a column of "Coming Soon" links would be
// noise. The Projects page remains the complete index.
const documented = projects.filter((p) => p.populated).slice(0, 8);
const year = new Date().getFullYear();
---
<footer class="bg-slate-950 border-t border-white/10">
  <div class="container mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">

      <div>
        <h3 class="text-2xl font-bold text-white mb-3 leading-tight">
          <span class="bg-gradient-to-r from-purple-400 to-blue-400 bg-clip-text text-transparent">
            {SITE_TITLE}
          </span>
        </h3>
        <p class="text-gray-400 text-sm leading-relaxed">
          Design and engineering work by {AUTHOR} — robotics, mechatronics,
          tooling, and mechanical design.
        </p>
      </div>

      <div>
        <span class="text-white font-semibold mb-4 block">Browse</span>
        <ul class="space-y-2">
          <li><a href={url('/')} class="text-gray-400 hover:text-white text-sm transition-colors duration-300">Home</a></li>
          <li><a href={url('/projects/')} class="text-gray-400 hover:text-white text-sm transition-colors duration-300">All Projects ({projectCount})</a></li>
          <li><a href={url('/about/')} class="text-gray-400 hover:text-white text-sm transition-colors duration-300">About</a></li>
        </ul>
      </div>

      <div>
        <span class="text-white font-semibold mb-4 block">
          {documented.length ? 'Documented Projects' : 'Projects'}
        </span>
        {documented.length ? (
          <ul class="space-y-2">
            {documented.map((p) => (
              <li>
                <a href={projectHref(p)} class="flex items-baseline gap-2 text-gray-400 hover:text-white text-sm transition-colors duration-300">
                  <span class="font-mono text-xs text-purple-400/70 w-[3ch] flex-shrink-0">{projectCode(p)}</span>
                  <span>{p.short}</span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-gray-500 text-sm">Write-ups in progress.</p>
        )}
      </div>
    </div>

    <div class="pt-8 border-t border-white/10">
      <div class="flex flex-col md:flex-row justify-between items-center gap-3">
        <p class="text-gray-400 text-sm">© {year} {AUTHOR}. All rights reserved.</p>
        <p class="text-gray-600 text-xs">
          {populatedCount} of {projectCount} projects documented
        </p>
      </div>
    </div>
  </div>
</footer>
