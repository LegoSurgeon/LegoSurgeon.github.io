---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects, projectCount, populatedCount, AUTHOR, SITE_TITLE } from '../../lib/projects.js';

// Filter chips are derived from the data, so a new discipline in the workbook
// becomes a filter without touching this file.
//
// Ordered by how many projects carry each one rather than alphabetically: 25 of
// the 42 disciplines appear on a single project, so an A–Z wall buries the
// filters worth clicking among ones that return one card. The frequent few are
// shown; the rest sit behind a toggle.
const disciplineCounts = new Map();
for (const p of projects) {
  for (const d of p.disciplines) disciplineCounts.set(d, (disciplineCounts.get(d) ?? 0) + 1);
}
const disciplines = [...disciplineCounts.keys()].sort(
  (a, b) => disciplineCounts.get(b) - disciplineCounts.get(a) || a.localeCompare(b)
);

const PRIMARY_FILTERS = 8;
const hiddenFilterCount = Math.max(0, disciplines.length - PRIMARY_FILTERS);

// The "written up so far" count only means something while sheets are still
// blank. With every project documented it just prints the same number twice,
// so the clause drops out until a new empty sheet appears.
const intro =
  populatedCount < projectCount
    ? `${projectCount} projects — ${populatedCount} written up so far, the rest in progress.`
    : `${projectCount} projects, each documented end to end.`;

// Each card carries its own searchable haystack; filtering is pure client-side
// string matching over these attributes.
const cards = projects.map((p) => ({
  project: p,
  haystack: [p.short, p.title, p.projectType, p.status, p.role, ...p.disciplines, ...p.tools]
    .filter(Boolean)
    .join(' ')
    .toLowerCase(),
}));
---
<BaseLayout
  title={`Projects — ${SITE_TITLE}`}
  description={`All ${projectCount} engineering projects by ${AUTHOR}, from robotics and mechatronics to tooling and mechanical design.`}
>
  <div class="min-h-screen bg-slate-900">

    <section class="relative pt-36 pb-14 overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-purple-900/30 via-slate-900 to-blue-900/30"></div>
      <div class="relative z-10 container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center">
          <div class="inline-flex items-center space-x-2 bg-purple-500/15 border border-purple-400/40 rounded-full px-5 py-2 mb-6">
            <Icon name="layers" size={16} class="text-purple-300" />
            <span class="text-purple-200 text-sm font-semibold tracking-wide uppercase">The Catalog</span>
          </div>
          <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold mb-6">
            <span class="bg-gradient-to-r from-purple-400 via-pink-400 to-blue-400 bg-clip-text text-transparent">
              Projects
            </span>
          </h1>
          <p class="text-lg sm:text-xl text-gray-300 leading-relaxed">
            {intro}
            Filter by discipline or search to narrow the list.
          </p>
        </div>
      </div>
    </section>

    <!--
      Sticky, so its height is spent on every screen for the whole page. Kept to
      a search field and one or two rows of chips; the rest expand on demand
      into a bounded, scrollable area so the bar can never grow past ~2 rows.
    -->
    <section class="bg-slate-950 border-t border-white/10 py-4 sticky top-[64px] z-[100] backdrop-blur-xl bg-slate-950/85">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto flex flex-col gap-3">

          <div class="relative">
            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-500 pointer-events-none">
              <Icon name="search" size={18} />
            </span>
            <input id="catalog-search" type="text" placeholder="Search projects, tools, disciplines…"
              autocomplete="off" spellcheck="false" aria-label="Filter projects"
              class="w-full bg-white/5 border border-white/10 rounded-xl pl-12 pr-4 py-2.5 text-white placeholder-gray-500 text-sm outline-none focus:border-purple-400/50 focus:bg-white/[0.07] transition-colors" />
          </div>

          <div class="flex items-start gap-2">
            <div id="catalog-filters" class="is-collapsed flex-1 flex flex-wrap gap-2 items-center">
              <button type="button" data-filter="" aria-pressed="true"
                class="catalog-chip is-active text-xs font-semibold px-3 py-1.5 rounded-full border transition-colors">
                All
              </button>
              {disciplines.map((d, i) => (
                <button type="button" data-filter={d.toLowerCase()} aria-pressed="false"
                  class={`catalog-chip text-xs font-semibold px-3 py-1.5 rounded-full border transition-colors ${i >= PRIMARY_FILTERS ? 'chip-extra' : ''}`}>
                  {d}
                </button>
              ))}
            </div>

            {hiddenFilterCount > 0 && (
              <button id="filters-toggle" type="button" aria-expanded="false" aria-controls="catalog-filters"
                class="flex-shrink-0 inline-flex items-center gap-1 text-xs font-semibold px-3 py-1.5 rounded-full border border-purple-400/30 bg-purple-500/10 text-purple-200 hover:bg-purple-500/20 hover:border-purple-400/50 transition-colors">
                <span data-more={`+${hiddenFilterCount} more`}>+{hiddenFilterCount} more</span>
                <Icon name="chevron-down" size={13} class="filters-chevron transition-transform duration-200" />
              </button>
            )}
          </div>

        </div>
      </div>
    </section>

    <section class="bg-slate-950 pb-20">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <div id="catalog-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {cards.map(({ project, haystack }) => (
              <div class="catalog-item" data-haystack={haystack}>
                <ProjectCard project={project} />
              </div>
            ))}
          </div>

          <p id="catalog-empty" class="hidden text-center text-gray-500 py-16">
            No projects match that filter.
          </p>
        </div>
      </div>
    </section>

  </div>

  <style is:global>
    .catalog-chip {
      border-color: rgba(255,255,255,0.10);
      background-color: rgba(255,255,255,0.04);
      color: rgb(156 163 175);
    }
    .catalog-chip:hover {
      border-color: rgba(192,132,252,0.35);
      color: rgb(216 180 254);
    }
    .catalog-chip.is-active {
      background: linear-gradient(to right, rgb(147 51 234), rgb(37 99 235));
      border-color: transparent;
      color: #fff;
    }

    /* Collapsed: only the frequent disciplines show. `:not(.is-active)` keeps a
       chip picked from the expanded list visible after collapsing, so the bar
       never claims "All" while a narrower filter is still applied. */
    #catalog-filters.is-collapsed .chip-extra:not(.is-active) { display: none; }

    /* Expanded: bounded and scrollable, so 42 chips can't push the grid off
       screen on a phone. The scrollbar is the cue that there is more. */
    #catalog-filters:not(.is-collapsed) {
      max-height: 7.5rem;
      overflow-y: auto;
      scrollbar-width: thin;
      scrollbar-color: rgba(192,132,252,0.35) transparent;
    }
    #catalog-filters:not(.is-collapsed)::-webkit-scrollbar { width: 6px; }
    #catalog-filters:not(.is-collapsed)::-webkit-scrollbar-thumb {
      background: rgba(192,132,252,0.35);
      border-radius: 3px;
    }

    #filters-toggle[aria-expanded='true'] .filters-chevron { transform: rotate(180deg); }

    @media (prefers-reduced-motion: reduce) {
      .filters-chevron { transition: none !important; }
    }
  </style>

  <script is:inline>
    (function () {
      var search = document.getElementById('catalog-search');
      var grid   = document.getElementById('catalog-grid');
      var empty  = document.getElementById('catalog-empty');
      if (!grid) return;

      var items = Array.from(grid.querySelectorAll('.catalog-item'));
      var chips = Array.from(document.querySelectorAll('.catalog-chip'));
      var activeFilter = '';

      function apply() {
        var q = (search && search.value || '').trim().toLowerCase();
        var shown = 0;

        items.forEach(function (item) {
          var hay = item.getAttribute('data-haystack') || '';

          // Every chip is a discipline now; "" is the All chip.
          var matchesChip = activeFilter === '' || hay.indexOf(activeFilter) !== -1;

          var matchesQuery = !q || hay.indexOf(q) !== -1;
          var visible = matchesChip && matchesQuery;

          item.style.display = visible ? '' : 'none';
          if (visible) shown++;
        });

        if (empty) empty.classList.toggle('hidden', shown > 0);
      }

      // Expand / collapse the discipline overflow.
      var filters = document.getElementById('catalog-filters');
      var toggle  = document.getElementById('filters-toggle');
      if (filters && toggle) {
        var label = toggle.querySelector('[data-more]');
        toggle.addEventListener('click', function () {
          var collapsed = filters.classList.toggle('is-collapsed');
          toggle.setAttribute('aria-expanded', String(!collapsed));
          if (label) label.textContent = collapsed ? label.getAttribute('data-more') : 'Show less';
          if (collapsed) filters.scrollTop = 0;
        });
      }

      chips.forEach(function (chip) {
        chip.addEventListener('click', function () {
          activeFilter = chip.getAttribute('data-filter') || '';
          chips.forEach(function (c) {
            var on = c === chip;
            c.classList.toggle('is-active', on);
            c.setAttribute('aria-pressed', String(on));
          });
          apply();
        });
      });

      if (search) search.addEventListener('input', apply);
      apply();
    })();
  </script>
</BaseLayout>
