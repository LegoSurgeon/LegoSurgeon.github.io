---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Gallery from '../../components/Gallery.astro';
import {
  projects, projectCode, projectTitle, projectHref,
  variantsOf, parentOf, neighborsOf, SITE_TITLE, AUTHOR,
} from '../../lib/projects.js';
import { url } from '../../lib/url.js';

// One page per workbook sheet. Adding a tab and re-running `npm run data` adds
// a page here with no code change.
export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;

const variants = variantsOf(project);
const parent = parentOf(project);
const { prev, next } = neighborsOf(project);
const title = projectTitle(project);

const facts = [
  { label: 'Status', value: project.status, icon: 'activity' },
  { label: 'Project Type', value: project.projectType, icon: 'shapes' },
  { label: 'Role', value: project.role, icon: 'user' },
].filter((f) => f.value);

const description = project.populated
  ? (project.overview.find((o) => o.label === 'What it is')?.text ?? project.overview[0]?.text ?? title).slice(0, 180)
  : `${title} — write-up in progress.`;
---
<BaseLayout title={`${title} — ${SITE_TITLE}`} description={description} type="article">
  <div class="min-h-screen bg-slate-900">

    <!-- Hero -->
    <section class="relative pt-32 pb-12 overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-purple-900/30 via-slate-900 to-blue-900/30"></div>
      <div class="relative z-10 container mx-auto px-4">
        <div class="max-w-4xl mx-auto">

          <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-sm text-gray-500 mb-6">
            <a href={url('/projects/')} class="hover:text-white transition-colors">Projects</a>
            {parent && (
              <>
                <Icon name="chevron-right" size={14} class="text-gray-700" />
                <a href={projectHref(parent)} class="hover:text-white transition-colors">{parent.short}</a>
              </>
            )}
            <Icon name="chevron-right" size={14} class="text-gray-700" />
            <span class="text-gray-400">{project.short}</span>
          </nav>

          <div class="flex flex-wrap items-center gap-3 mb-5">
            <span class="font-mono text-sm font-bold px-2.5 py-1 rounded-md bg-purple-500/15 border border-purple-400/40 text-purple-200">
              {projectCode(project)}
            </span>
            {project.status && (
              <span class="inline-flex items-center gap-2 text-xs font-semibold px-3 py-1 rounded-full bg-blue-500/15 border border-blue-400/40 text-blue-200">
                <span class="w-1.5 h-1.5 rounded-full bg-blue-400 animate-pulse"></span>
                {project.status}
              </span>
            )}
            {!project.populated && (
              <span class="text-xs font-semibold px-3 py-1 rounded-full bg-slate-800 border border-white/10 text-gray-400">
                Coming Soon
              </span>
            )}
          </div>

          <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-5 leading-tight">
            <span class="bg-gradient-to-r from-purple-400 via-pink-400 to-blue-400 bg-clip-text text-transparent">
              {title}
            </span>
          </h1>

          {project.projectType && (
            <p class="text-lg sm:text-xl text-gray-300 leading-relaxed">{project.projectType}</p>
          )}
        </div>
      </div>
    </section>

    {project.populated ? (
      <>
        <!-- Facts + capability chips -->
        {(facts.length > 0 || project.disciplines.length > 0 || project.tools.length > 0) && (
          <section class="bg-slate-950 border-y border-white/10 py-10">
            <div class="container mx-auto px-4">
              <div class="max-w-4xl mx-auto grid gap-8">

                {facts.length > 0 && (
                  <dl class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                    {facts.map((f) => (
                      <div>
                        <dt class="flex items-center gap-2 text-xs uppercase tracking-wide text-gray-500 mb-2">
                          <Icon name={f.icon} size={14} class="text-purple-400" />
                          {f.label}
                        </dt>
                        <dd class="text-white text-sm leading-relaxed">{f.value}</dd>
                      </div>
                    ))}
                  </dl>
                )}

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                  {project.disciplines.length > 0 && (
                    <div>
                      <h2 class="flex items-center gap-2 text-xs uppercase tracking-wide text-gray-500 mb-3">
                        <Icon name="compass" size={14} class="text-purple-400" />
                        Disciplines
                      </h2>
                      <ul class="flex flex-wrap gap-2">
                        {project.disciplines.map((d) => (
                          <li class="text-xs px-3 py-1.5 rounded-lg bg-purple-500/10 border border-purple-400/25 text-purple-200">{d}</li>
                        ))}
                      </ul>
                    </div>
                  )}

                  {project.tools.length > 0 && (
                    <div>
                      <h2 class="flex items-center gap-2 text-xs uppercase tracking-wide text-gray-500 mb-3">
                        <Icon name="wrench" size={14} class="text-blue-400" />
                        Tools
                      </h2>
                      <ul class="flex flex-wrap gap-2">
                        {project.tools.map((t) => (
                          <li class="text-xs px-3 py-1.5 rounded-lg bg-blue-500/10 border border-blue-400/25 text-blue-200">{t}</li>
                        ))}
                      </ul>
                    </div>
                  )}
                </div>

              </div>
            </div>
          </section>
        )}

        <!-- Narrative -->
        {project.overview.length > 0 && (
          <section class="bg-slate-900 py-16">
            <div class="container mx-auto px-4">
              <div class="max-w-3xl mx-auto">
                <h2 class="text-3xl sm:text-4xl font-bold text-white mb-10">Project Overview</h2>
                <div class="space-y-10">
                  {project.overview.map((block) => (
                    <div class="border-l-2 border-purple-500/30 pl-6">
                      <h3 class="text-xl font-bold text-white mb-3">{block.label}</h3>
                      <p class="text-gray-300 leading-relaxed text-base sm:text-lg">{block.text}</p>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </section>
        )}

        <!-- Gallery -->
        {project.images.length > 0 && (
          <section class="bg-slate-950 border-t border-white/10 py-16">
            <div class="container mx-auto px-4">
              <div class="max-w-5xl mx-auto">
                <h2 class="text-3xl sm:text-4xl font-bold text-white mb-8">Gallery</h2>
                <Gallery images={project.images} title={title} />
              </div>
            </div>
          </section>
        )}
      </>
    ) : (
      <!-- Placeholder for a sheet that has a title but no content yet -->
      <section class="bg-slate-950 border-y border-white/10 py-20">
        <div class="container mx-auto px-4">
          <div class="max-w-2xl mx-auto text-center bg-gradient-to-br from-purple-900/20 to-blue-900/20 rounded-2xl p-10 border border-white/10">
            <Icon name="pencil-ruler" size={40} class="text-purple-400/60 mx-auto mb-5" />
            <h2 class="text-2xl font-bold text-white mb-3">Write-Up In Progress</h2>
            <p class="text-gray-400 leading-relaxed mb-8">
              This project is part of the portfolio, but its documentation hasn't been
              written yet. It will appear here as soon as the workbook entry is filled in.
            </p>
            <a href={url('/projects/')}
              class="inline-flex items-center gap-2 bg-gradient-to-r from-purple-600 to-blue-600 hover:from-purple-700 hover:to-blue-700 text-white px-6 py-3 rounded-lg font-semibold transition-all duration-300 hover:scale-105 shadow-lg">
              <span>Browse other projects</span>
              <Icon name="arrow-right" size={18} />
            </a>
          </div>
        </div>
      </section>
    )}

    <!-- Sub-pages (1B, 1C… beneath 1A) -->
    {variants.length > 0 && (
      <section class="bg-slate-900 py-14 border-t border-white/10">
        <div class="container mx-auto px-4">
          <div class="max-w-4xl mx-auto">
            <h2 class="text-2xl font-bold text-white mb-6">More on this project</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {variants.map((v) => (
                <a href={projectHref(v)}
                  class="group flex items-center gap-4 p-5 rounded-xl bg-slate-800/40 border border-white/10 hover:border-purple-400/40 hover:bg-slate-800/70 transition-all duration-300">
                  <span class="font-mono text-xs font-bold px-2 py-1 rounded-md bg-purple-500/15 border border-purple-400/30 text-purple-300 flex-shrink-0">
                    {projectCode(v)}
                  </span>
                  <span class="flex-1 min-w-0">
                    <span class="block text-white font-semibold group-hover:text-purple-300 transition-colors truncate">{projectTitle(v)}</span>
                    {!v.populated && <span class="block text-xs text-gray-600 mt-0.5">Coming soon</span>}
                  </span>
                  <Icon name="arrow-right" size={18} class="text-purple-400 flex-shrink-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
                </a>
              ))}
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- Prev / next across workbook order -->
    <section class="bg-slate-950 border-t border-white/10 py-10">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto grid grid-cols-1 sm:grid-cols-2 gap-4">
          {prev ? (
            <a href={projectHref(prev)} class="group flex items-center gap-3 p-5 rounded-xl border border-white/10 hover:border-purple-400/40 hover:bg-white/[0.03] transition-all duration-300">
              <Icon name="arrow-left" size={20} class="text-purple-400 flex-shrink-0" />
              <span class="min-w-0">
                <span class="block text-xs text-gray-500 mb-0.5">Previous</span>
                <span class="block text-white text-sm font-semibold truncate group-hover:text-purple-300 transition-colors">{prev.short}</span>
              </span>
            </a>
          ) : <div class="hidden sm:block"></div>}

          {next && (
            <a href={projectHref(next)} class="group flex items-center justify-end gap-3 p-5 rounded-xl border border-white/10 hover:border-purple-400/40 hover:bg-white/[0.03] transition-all duration-300 text-right">
              <span class="min-w-0">
                <span class="block text-xs text-gray-500 mb-0.5">Next</span>
                <span class="block text-white text-sm font-semibold truncate group-hover:text-purple-300 transition-colors">{next.short}</span>
              </span>
              <Icon name="arrow-right" size={20} class="text-purple-400 flex-shrink-0" />
            </a>
          )}
        </div>
      </div>
    </section>

  </div>
</BaseLayout>
