---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { AUTHOR, SITE_TITLE, LINKEDIN_URL } from '../lib/projects.js';
import { url } from '../lib/url.js';

// LinkedIn is the only channel this page advertises. The additional-info
// workbook also lists an email address and a phone number for the footer; those
// are deliberately not published here — adding them is a decision for Nick, not
// a side effect of building this page.
const handle = LINKEDIN_URL.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---
<BaseLayout
  title={`Contact — ${SITE_TITLE}`}
  description={`Get in touch with ${AUTHOR} — connect on LinkedIn.`}
>
  <div class="min-h-screen bg-slate-900 flex flex-col">

    <section class="relative pt-36 pb-14 overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-purple-900/30 via-slate-900 to-blue-900/30"></div>
      <div class="relative z-10 container mx-auto px-4">
        <div class="max-w-3xl mx-auto text-center">
          <div class="inline-flex items-center space-x-2 bg-purple-500/15 border border-purple-400/40 rounded-full px-5 py-2 mb-6">
            <Icon name="mail" size={16} class="text-purple-300" />
            <span class="text-purple-200 text-sm font-semibold tracking-wide uppercase">Contact</span>
          </div>
          <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold mb-6">
            <span class="bg-gradient-to-r from-purple-400 via-pink-400 to-blue-400 bg-clip-text text-transparent">
              Get in Touch
            </span>
          </h1>
          <p class="text-base sm:text-lg text-gray-300 leading-relaxed">
            Connect with me on LinkedIn — I'm happy to talk about mechanical design,
            robotics, or any of the work in this portfolio.
          </p>
        </div>
      </div>
    </section>

    <section class="bg-slate-950 border-y border-white/10 py-16 flex-grow">
      <div class="container mx-auto px-4">
        <div class="max-w-xl mx-auto">

          <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer"
            class="group flex items-center gap-5 p-6 rounded-2xl bg-slate-800/40 border border-white/10 hover:border-purple-400/40 hover:bg-slate-800/70 transition-all duration-300">
            <span class="flex items-center justify-center w-14 h-14 rounded-xl bg-purple-500/15 border border-purple-400/30 flex-shrink-0">
              <Icon name="linkedin" size={26} class="text-purple-300" />
            </span>
            <span class="flex-1 min-w-0">
              <span class="block text-white font-semibold text-lg group-hover:text-purple-300 transition-colors">
                Connect with me on LinkedIn
              </span>
              <!-- break-all: the profile slug is one long unbroken token -->
              <span class="block text-sm text-gray-400 mt-1 break-all">{handle}</span>
            </span>
            <Icon name="arrow-up-right" size={22}
              class="text-purple-400 flex-shrink-0 opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300" />
          </a>

          <p class="text-center text-sm text-gray-500 mt-8">
            Prefer to look around first?
            <a href={url('/projects/')} class="text-purple-300 hover:text-purple-200 underline decoration-purple-400/40 underline-offset-2 transition-colors">
              Browse the projects
            </a>
            or
            <a href={url('/about/')} class="text-purple-300 hover:text-purple-200 underline decoration-purple-400/40 underline-offset-2 transition-colors">
              read more about me</a>.
          </p>

        </div>
      </div>
    </section>

  </div>
</BaseLayout>
