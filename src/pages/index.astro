---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import {
  projects, projectCount, populatedCount,
  projectCode, projectTitle, projectHref,
  AUTHOR, SITE_TITLE,
} from '../lib/projects.js';
import { url } from '../lib/url.js';

// Lead with documented work; fall back to workbook order before anything is
// written so the home page is never empty.
const featured = (projects.filter((p) => p.populated).length
  ? projects.filter((p) => p.populated)
  : projects
).slice(0, 3);

const disciplines = [...new Set(projects.flatMap((p) => p.disciplines))];
const tools = [...new Set(projects.flatMap((p) => p.tools))];
---
<BaseLayout>
  <div class="min-h-screen bg-slate-900">

    <!-- Hero -->
    <section class="relative pt-40 pb-24 overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-purple-900/40 via-slate-900 to-blue-900/40"></div>
      <div class="absolute inset-0 opacity-[0.15] pointer-events-none"
        style="background-image:radial-gradient(circle at 1px 1px, rgba(255,255,255,0.5) 1px, transparent 0);background-size:32px 32px;"></div>

      <div class="relative z-10 container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center">
          <div class="inline-flex items-center space-x-2 bg-purple-500/15 border border-purple-400/40 rounded-full px-5 py-2 mb-8">
            <Icon name="cpu" size={16} class="text-purple-300" />
            <span class="text-purple-200 text-sm font-semibold tracking-wide uppercase">
              Mechanical · Mechatronic · Electronic
            </span>
          </div>

          <h1 class="text-4xl sm:text-6xl md:text-7xl font-bold mb-6 leading-[1.05]">
            <span class="bg-gradient-to-r from-purple-400 via-pink-400 to-blue-400 bg-clip-text text-transparent">
              The Engineering Portfolio
            </span>
          </h1>

          <p class="text-xl sm:text-2xl text-white font-semibold mb-6">{AUTHOR}</p>

          <p class="text-base sm:text-xl text-gray-300 leading-relaxed max-w-2xl mx-auto mb-10">
            A catalog of design and engineering work — robotics chassis architecture,
            mechatronic systems, custom tooling, and mechanical design, each documented
            from intent through to what it taught me.
          </p>

          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a href={url('/projects/')}
              class="w-full sm:w-auto inline-flex items-center justify-center space-x-2 bg-gradient-to-r from-purple-600 to-blue-600 hover:from-purple-700 hover:to-blue-700 text-white px-8 py-4 rounded-lg font-semibold transition-all duration-300 hover:scale-105 shadow-lg">
              <span>Browse All {projectCount} Projects</span>
              <Icon name="arrow-right" size={20} />
            </a>
            <a href={url('/about/')}
              class="w-full sm:w-auto inline-flex items-center justify-center space-x-2 bg-white/5 hover:bg-white/10 text-white px-8 py-4 rounded-lg font-semibold transition-all duration-300 border border-white/20">
              <span>About the Author</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- At a glance -->
    <section class="bg-slate-950 border-y border-white/10 py-12">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto grid grid-cols-3 gap-6 text-center">
          <div>
            <p class="text-4xl sm:text-5xl font-bold bg-gradient-to-r from-purple-400 to-blue-400 bg-clip-text text-transparent">{projectCount}</p>
            <p class="text-gray-400 text-xs sm:text-sm mt-2">Projects</p>
          </div>
          <div>
            <p class="text-4xl sm:text-5xl font-bold bg-gradient-to-r from-purple-400 to-blue-400 bg-clip-text text-transparent">{disciplines.length}</p>
            <p class="text-gray-400 text-xs sm:text-sm mt-2">Disciplines</p>
          </div>
          <div>
            <p class="text-4xl sm:text-5xl font-bold bg-gradient-to-r from-purple-400 to-blue-400 bg-clip-text text-transparent">{tools.length}</p>
            <p class="text-gray-400 text-xs sm:text-sm mt-2">Tools</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Featured -->
    <section class="bg-slate-950 py-16">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <div class="flex flex-wrap items-end justify-between gap-4 mb-10">
            <div>
              <h2 class="text-3xl sm:text-4xl font-bold text-white">Featured Work</h2>
              <p class="text-gray-400 mt-2">
                {populatedCount} of {projectCount} projects documented so far.
              </p>
            </div>
            <a href={url('/projects/')} class="inline-flex items-center gap-2 text-purple-300 hover:text-purple-200 font-semibold text-sm transition-colors">
              <span>View all</span>
              <Icon name="arrow-right" size={16} />
            </a>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {featured.map((p) => <ProjectCard project={p} />)}
          </div>
        </div>
      </div>
    </section>

    <!-- Full index -->
    <section class="bg-slate-900 py-16 border-t border-white/10">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl sm:text-4xl font-bold text-white mb-3">The Full Index</h2>
          <p class="text-gray-400 mb-8">Every project in the portfolio, in workbook order.</p>

          <div class="rounded-2xl border border-white/10 overflow-hidden divide-y divide-white/5">
            {projects.map((p) => (
              <a href={projectHref(p)}
                class="group flex items-center gap-4 px-5 py-4 hover:bg-white/[0.03] transition-colors duration-200">
                <span class="font-mono text-xs font-bold w-[3ch] flex-shrink-0 text-purple-400/70">{projectCode(p)}</span>
                <span class={`flex-1 min-w-0 truncate text-sm sm:text-base ${p.populated ? 'text-white group-hover:text-purple-300' : 'text-gray-500'} transition-colors`}>
                  {projectTitle(p)}
                </span>
                {p.status && <span class="hidden sm:inline text-xs text-blue-300/70 flex-shrink-0">{p.status}</span>}
                {!p.populated && <span class="text-[10px] uppercase tracking-wide text-gray-600 flex-shrink-0">Soon</span>}
                <Icon name="chevron-right" size={16} class="text-gray-700 group-hover:text-purple-400 transition-colors flex-shrink-0" />
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Disciplines -->
    {disciplines.length > 0 && (
      <section class="bg-slate-950 py-16 border-t border-white/10">
        <div class="container mx-auto px-4">
          <div class="max-w-4xl mx-auto text-center">
            <h2 class="text-3xl sm:text-4xl font-bold text-white mb-8">Disciplines Across the Portfolio</h2>
            <ul class="flex flex-wrap justify-center gap-3">
              {disciplines.map((d) => (
                <li class="text-sm px-4 py-2 rounded-lg bg-purple-500/10 border border-purple-400/25 text-purple-200">{d}</li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    )}

  </div>
</BaseLayout>
