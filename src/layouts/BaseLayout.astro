---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { AUTHOR, SITE_TITLE } from '../lib/projects.js';
import { url, assetUrl } from '../lib/url.js';

// The image link-preview scrapers (Viber, iMessage, Slack…) show when the site
// is shared. Pages can override with an `image` prop; everything else falls
// back to this one.
const DEFAULT_SHARE_IMAGE = '/images/Screenshot 2026-08-28 190429.png';

const {
  title = `${SITE_TITLE} — ${AUTHOR}`,
  description = `Design and engineering work by ${AUTHOR}: robotics, mechatronics, tooling, and mechanical design.`,
  type = 'website',
  image = DEFAULT_SHARE_IMAGE,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(assetUrl(image), Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
  </head>
  <body class="min-h-screen bg-slate-900 text-white flex flex-col">
    <Header />
    <main class="flex-grow overflow-x-hidden">
      <slot />
    </main>
    <Footer />
  </body>
</html>
